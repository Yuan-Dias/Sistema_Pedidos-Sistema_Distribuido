# Configurações do Frontend (Vite)
# Por padrão, o Vite utiliza o proxy reverso definido no vite.config.ts para evitar bloqueios de CORS:
#   /api/catalogo     -> http://localhost:8082
#   /api/pedidos      -> http://localhost:8083
#   /api/notificacoes -> http://localhost:8084

# Para disparar requisições diretamente para as portas locais (sem proxy):
# VITE_USE_DIRECT_URLS=true
# VITE_CATALOGO_URL=http://localhost:8082
# VITE_PEDIDOS_URL=http://localhost:8083
# VITE_NOTIFICACAO_URL=http://localhost:8084
